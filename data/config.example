# Copy to .selmem in the working directory (not a SELMEM1 vault).
# Precedence: --flag > SELMEM_* env > this file > default.
#
#   cp data/config.example .selmem
#   ./run.sh run --release --bin selmemd
#
# Both mouths live here. defaultLlm is what the daemon attaches.
# The UI select switches between these blocks. Keys stay in this file.

defaultLlm=grok

reasoning=none
temp=0
http_timeout=60

# GENESIS uses the selected provider for decisions and memory operations.
# bash experiments/genesis/run-positive-control.sh
# bash experiments/genesis/run-evidence-learning.sh
# Optional independent memory cuts (global keys before provider sections):
# associations_learn=true
# associations_reconstruct=true
# observation_evidence=true
# Observation support requires stable source-scoped observation IDs.

[grok]
llm=https://api.x.ai/v1/chat/completions
model=grok-4.3
api_key=

[gpt]
llm=https://api.openai.com/v1/chat/completions
model=gpt-4o-mini
api_key=

# embed=
# embed_model=text-embedding-3-small

# bind=127.0.0.1:7420
# path=claire.db
# name=Claire
# profile=tender
# token=

# ground_overlap=0.18
# ground_strikes=3
# narrator_firmness=0.42

# probes=2
# quick=false

# GENESIS experimental reconstruction audit and probe information regime:
# genesis_reconstruction_policy=native
# genesis_probe_panel=known
# Before a paid campaign (50 HTTP attempts maximum, including retries):
# ./run.sh run --release --bin selmem-genesis -- diagnostic --out experiments/genesis/results/diagnostic-001
# Repeated positive/negative/empty diagnostic (45 decisions, <=200 HTTP attempts):
# ./run.sh run --release --bin selmem-genesis -- contrast --out experiments/genesis/results/contrast-001
