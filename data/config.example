# Copy to .selmem in the working directory (not a SELMEM1 vault).
# Precedence: --flag > SELMEM_* env > this file > default.
#
#   cp data/config.example .selmem
#   ./run.sh run --release --bin selmemd

llm=https://api.x.ai/v1/chat/completions
model=grok-4.3
# api_key=
reasoning=none
temp=0
http_timeout=60

